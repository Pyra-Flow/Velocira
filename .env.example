# Copy to .env before starting. Replace all three required placeholder secrets.
POSTGRES_DB=velocira_db
POSTGRES_USER=velocira
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
JWT_SECRET=replace-with-a-base64-secret-containing-at-least-32-bytes
AI_SERVICE_SHARED_SECRET=replace-with-a-long-random-internal-service-secret

# Published host ports.
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Browser-visible URLs/origins. Change these when not running on localhost.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Google login and mail delivery.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.invalid

# The deterministic provider works without an external API key.
AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_PROVIDER=deterministic
AI_SERVICE_MODEL=velocira-deterministic-v1
AI_SERVICE_FALLBACK_MODEL=
GEMINI_API_KEY=
AI_SERVICE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_SERVICE_MAX_INPUT_BYTES=65536
AI_SERVICE_LOG_LEVEL=INFO
AI_SERVICE_QDRANT_COLLECTION=velocira_project_evidence_v1
AI_SERVICE_EMBEDDING_MODEL=gemini-embedding-2
AI_SERVICE_EMBEDDING_DIMENSIONS=768

APP_LOG_LEVEL=INFO
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_READ_TIMEOUT=30s
AI_SERVICE_DISCOVERY_PLANNER_ENABLED=true

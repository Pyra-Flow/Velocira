# Deterministic is the clean-clone default. For Gemini development, set
# AI_SERVICE_PROVIDER=gemini and keep GEMINI_API_KEY in an uncommitted .env.
AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_PROVIDER=deterministic
AI_SERVICE_MODEL=velocira-deterministic-v1
AI_SERVICE_FALLBACK_MODEL=
GEMINI_API_KEY=
AI_SERVICE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_SERVICE_MAX_INPUT_BYTES=65536
AI_SERVICE_LOG_LEVEL=INFO

# Phase 4 governed retrieval. The recommended 768 dimensions work with the
# Gemini embedding model and keep local Qdrant storage compact.
AI_SERVICE_QDRANT_URL=http://localhost:6333
AI_SERVICE_QDRANT_COLLECTION=velocira_project_evidence_v1
AI_SERVICE_EMBEDDING_MODEL=gemini-embedding-2
AI_SERVICE_EMBEDDING_DIMENSIONS=768

# Leave empty for local development. In staging/production set a long random
# value and configure the Spring backend to send it as X-Internal-Token.
AI_SERVICE_INTERNAL_TOKEN=

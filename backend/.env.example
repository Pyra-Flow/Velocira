# =============================================================================
# Velocira Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.

# ======================== Server ========================
SERVER_PORT=8080

# ======================== Database ========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YourDatabaseNameHere
DB_USERNAME=YourUsernameHere
DB_PASSWORD=YourStrongPasswordHere

# ======================== JWT ========================
JWT_SECRET=YourJwtSecretKeyHere256CharactersMinimum

# ======================== Google OAuth2 ========================
GOOGLE_CLIENT_ID=YourGoogleClientIdHere
GOOGLE_CLIENT_SECRET=YourGoogleClientSecretHere
# ======================== Email / SMTP ========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YourEmailHere
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_FROM=YourEmailHere
# Copy this file to .env and replace every value before running the backend.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velocira_db
DB_USERNAME=velocira
DB_PASSWORD=replace-with-a-long-unique-database-password

POSTGRES_DB=velocira_db
POSTGRES_USER=velocira
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
# Host port published by Compose. If a local PostgreSQL already owns 5432,
# choose another value (for example 5433) and set DB_PORT to the same value.
POSTGRES_PORT=5432

# Base64-encoded secret with at least 256 bits of entropy.
JWT_SECRET=replace-with-a-generated-base64-secret

# Optional integrations. Leave blank when not configured.
GOOGLE_CLIENT_ID=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.invalid
APP_LOG_LEVEL=INFO

# Internal generation service. Use the same long random value for
# AI_SERVICE_SHARED_SECRET and ai-service/AI_SERVICE_INTERNAL_TOKEN outside
# local development. It is never sent to the browser.
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=replace-with-a-long-random-internal-service-secret
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_DISCOVERY_PLANNER_ENABLED=true
AI_SERVICE_DISCOVERY_PLANNER_TIMEOUT=120s
AI_SERVICE_READ_TIMEOUT=30m

# Gemini development provider (optional). Keep GEMINI_API_KEY only in the
# uncommitted .env file; the AI service is the sole process that reads it.
AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_PROVIDER=deterministic
AI_SERVICE_MODEL=velocira-deterministic-v1
AI_SERVICE_DISCOVERY_MODEL=velocira-deterministic-v1
AI_SERVICE_FALLBACK_MODEL=
# Gemini routing (replace the deterministic values above when enabling Gemini):
# AI_SERVICE_PROVIDER=gemini
# AI_SERVICE_MODEL=gemini-3.1-flash-lite-preview
# AI_SERVICE_DISCOVERY_MODEL=gemini-3.6-flash
# AI_SERVICE_FALLBACK_MODEL=  # Discovery is fail-closed; do not configure a silent model switch.
GEMINI_API_KEY=
AI_SERVICE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_SERVICE_PROVIDER_TIMEOUT_SECONDS=600

# Governed Phase 4 retrieval. For the complete Docker stack, copy the root
# .env.example to the repository-root .env and run `docker compose up --build`.
# The AI service receives http://qdrant:6333 inside the Compose network.
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
AI_SERVICE_EMBEDDING_MODEL=gemini-embedding-2
AI_SERVICE_EMBEDDING_DIMENSIONS=768
